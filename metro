#!/usr/bin/env bash
# Metro Assistant başlatıcı
set -euo pipefail
HERE="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$HERE"

if [[ ! -x venv/bin/python ]]; then
  echo "İlk çalıştırma algılandı — otomatik kurulum başlatılıyor..."
  bash "$HERE/install.sh"
fi

exec venv/bin/python -m metroai "$@"
